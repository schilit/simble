<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.simble">

    <!-- The sink advertises; the source scans. BLUETOOTH_SCAN carries
         neverForLocation, which is what keeps ACCESS_FINE_LOCATION off this
         manifest: we scan to find a SimBLE service, never to place the device. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- The stats server. The counters must leave this device by a path that
         is not the link being measured: anything sent over Bluetooth costs
         air time, ends the measured transfer a round trip late, and cannot
         arrive at all when the run is a deliberately broken link. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hold the CPU and wifi awake so the sink survives the screen turning off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:label="SimBLE Android"
        android:allowBackup="false">
        <activity
            android:name=".SimbleActivity"
            android:exported="true"
            android:label="SimBLE Android">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
