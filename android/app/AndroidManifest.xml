<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.simble.sink">

    <!-- Advertise and serve only. We never scan, which is what keeps
         ACCESS_FINE_LOCATION off this manifest: a scanning app must ask for
         location, a peripheral need not. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- The stats server. The counters must leave this device by a path that
         is not the link being measured: anything sent over Bluetooth costs
         air time, ends the measured transfer a round trip late, and cannot
         arrive at all when the run is a deliberately broken link. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:label="SimBLE Sink"
        android:allowBackup="false">
        <activity
            android:name=".SinkActivity"
            android:exported="true"
            android:label="SimBLE Sink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
